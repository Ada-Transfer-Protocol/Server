# AdaTP Server Configuration

# Networking — single unified port (WebSocket /ws + HTTP API)
HOST=0.0.0.0
PORT=3000

# Logging
RUST_LOG=info

# Authentication driver: file | api | none
#   file — verify against AUTH_FILE_PATH (users.json). Dev/demo only:
#          the file stores plaintext passwords.
#   api  — POST {username,password} to AUTH_API_URL;
#          expects { "authorized": true, "user_id": "...", "role": "..." }
#   none — anonymous mode: every login is accepted with role "anonymous".
#          Never use in production.
AUTH_DRIVER=file
AUTH_FILE_PATH=users.json
#AUTH_API_URL=https://my-backend.com/api/auth

# Database (HTTP API keys)
DATABASE_URL=sqlite:adatp.db

# Limits
MAX_FRAME_BYTES=1048576
IDLE_TIMEOUT_SECS=90
